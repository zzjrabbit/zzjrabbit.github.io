---
import { randomUUID } from 'node:crypto';
import { Icon } from '@astrojs/starlight/components';

// Starlight renders separate desktop and mobile pickers. Keep their native
// radio groups independent, then synchronize their values in the controller.
const groupName = `theme-${randomUUID()}`;
const options = [
  { value: 'light', label: Astro.locals.t('themeSelect.light'), icon: 'sun' },
  { value: 'dark', label: Astro.locals.t('themeSelect.dark'), icon: 'moon' },
  { value: 'auto', label: 'System', icon: 'laptop' },
] as const;
---

<starlight-theme-select data-notebook-theme>
  {/* Preserve the interface used by StarlightThemeProvider.updatePickers(). */}
  <select hidden aria-hidden="true" tabindex="-1" data-theme-bridge>
    {options.map(({ value, label }) => <option value={value} selected={value === 'auto'}>{label}</option>)}
  </select>
  <fieldset class="theme-picker">
    <legend class="sr-only">{Astro.locals.t('themeSelect.accessibleLabel')}</legend>
    {options.map(({ value, label, icon }) => (
      <label class="theme-option" title={value === 'auto' ? 'Follow your device’s appearance' : `${label} appearance`}>
        <input type="radio" name={groupName} value={value} checked={value === 'auto'} />
        <span class="theme-segment">
          <Icon name={icon} size="1rem" />
          <span>{label}</span>
        </span>
      </label>
    ))}
  </fieldset>
</starlight-theme-select>

{/* Initialize the visible selection before deferred scripts, just like the
    default picker. The head's ThemeProvider remains responsible for no-FOUC. */}
<script is:inline>
  if (window.StarlightThemeProvider) {
    window.StarlightThemeProvider.updatePickers();
    document.querySelectorAll('starlight-theme-select[data-notebook-theme]').forEach((picker) => {
      const value = picker.querySelector('select').value;
      picker.querySelectorAll('input[type="radio"]').forEach((input) => {
        input.checked = input.value === value;
      });
    });
  }
</script>

<script>
  type Theme = 'light' | 'dark' | 'auto';
  const storageKey = 'starlight-theme';
  const selector = 'starlight-theme-select[data-notebook-theme]';
  const systemScheme = window.matchMedia('(prefers-color-scheme: light)');
  const parseTheme = (value: unknown): Theme => value === 'light' || value === 'dark' ? value : 'auto';

  function loadTheme(fallback: Theme = 'auto'): Theme {
    try {
      return parseTheme(window.localStorage.getItem(storageKey));
    } catch {
      // Private/restricted contexts can reject storage; the picker still works.
      return fallback;
    }
  }

  let preference = loadTheme();

  function applyTheme(theme: Theme, persist = false) {
    preference = theme;
    document.documentElement.dataset.theme = theme === 'auto'
      ? (systemScheme.matches ? 'light' : 'dark')
      : theme;
    if (typeof StarlightThemeProvider !== 'undefined') {
      StarlightThemeProvider.updatePickers(theme);
    }
    document.querySelectorAll(selector).forEach((picker) => {
      const bridge = picker.querySelector<HTMLSelectElement>('select');
      if (bridge) bridge.value = theme;
      picker.querySelectorAll<HTMLInputElement>('input[type="radio"]').forEach((input) => {
        input.checked = input.value === theme;
      });
    });
    if (persist) {
      try {
        // Starlight represents System with an empty value, not the word 'auto'.
        window.localStorage.setItem(storageKey, theme === 'auto' ? '' : theme);
      } catch {
        // Keep the in-memory preference when persistence is unavailable.
      }
    }
  }

  class NotebookThemeSelect extends HTMLElement {
    private controller?: AbortController;

    connectedCallback() {
      this.controller?.abort();
      this.controller = new AbortController();
      applyTheme(loadTheme(preference));
      this.addEventListener('change', (event) => {
        if (event.target instanceof HTMLInputElement && event.target.type === 'radio') {
          applyTheme(parseTheme(event.target.value), true);
        }
      }, { signal: this.controller.signal });
    }

    disconnectedCallback() {
      this.controller?.abort();
    }
  }

  if (!customElements.get('starlight-theme-select')) {
    customElements.define('starlight-theme-select', NotebookThemeSelect);
  }
  systemScheme.addEventListener('change', () => {
    if (preference === 'auto') applyTheme('auto');
  });
  window.addEventListener('storage', (event) => {
    // A null key means another tab cleared localStorage entirely.
    if (event.key === storageKey || event.key === null) {
      try {
        if (event.storageArea === window.localStorage) applyTheme(parseTheme(event.newValue));
      } catch { /* Storage access can be revoked while this page is open. */ }
    }
  });
  document.addEventListener('astro:page-load', () => applyTheme(loadTheme(preference)));
</script>

<style>
  starlight-theme-select {
    display: inline-flex;
    flex-shrink: 0;
    vertical-align: middle;
  }

  .theme-picker {
    display: flex;
    gap: .2rem;
    min-width: 0;
    margin: 0;
    padding: .2rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: .75rem;
    background: color-mix(in srgb, var(--sl-color-bg) 65%, var(--sl-color-bg-nav));
    box-shadow: inset 0 1px 2px #00000006;
  }

  .theme-option {
    position: relative;
    display: block;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .theme-option input,
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  .theme-segment {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: .35rem;
    min-width: 3.65rem;
    min-height: 2.75rem;
    padding-inline: .45rem;
    border: 1px solid transparent;
    border-radius: .55rem;
    color: var(--sl-color-gray-2);
    font: 550 .7rem/1 var(--sl-font);
    transition: color .16s ease, background-color .16s ease, border-color .16s ease, box-shadow .16s ease;
    user-select: none;
  }

  .theme-option:hover .theme-segment {
    background: var(--sl-color-gray-6);
    color: var(--sl-color-white);
  }

  .theme-option input:checked + .theme-segment {
    background: var(--sl-color-accent-low);
    border-color: color-mix(in srgb, var(--sl-color-text-accent) 24%, transparent);
    color: var(--sl-color-text-accent);
    box-shadow: 0 1px 3px #0000000a;
  }

  .theme-option input:focus-visible + .theme-segment {
    outline: 2px solid var(--sl-color-text-accent);
    outline-offset: 2px;
  }

  @media (forced-colors: active) {
    .theme-option input:checked + .theme-segment {
      border-color: Highlight;
      outline: 1px solid Highlight;
      color: Highlight;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .theme-segment { transition: none; }
  }
</style>
