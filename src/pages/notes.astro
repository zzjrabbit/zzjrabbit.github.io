---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import NoteRow from '../components/NoteRow.astro';
import notes from '../../.generated/notes.json';
import subjectManifests from '../../.generated/subjects.json';
import { buildLibrary, formatDate } from '../lib/notebook.mjs';
// The complete index: one section per track, one section per subject inside it,
// dense rows instead of cards so the page stays readable when the notebook
// grows.
const library = buildLibrary(notes, subjectManifests);
const { tracks, subjects, total } = library;
const latest = library.notes.find(note => note.date)?.date || '';
const populated = tracks.filter(track => track.subjects.length > 0);
const headings = [
  ...populated.map(track => ({ depth: 2, slug: `track-${track.key}`, text: track.label })),
  ...subjects.map(subject => ({ depth: 3, slug: `subject-${subject.slug}`, text: subject.label })),
];
const description = `Every note in the notebook, filed under ${tracks.length} ${tracks.length === 1 ? 'track' : 'tracks'} and ${subjects.length} ${subjects.length === 1 ? 'subject' : 'subjects'}, newest first.`;
---
<StarlightPage frontmatter={{ title: 'All notes', description, editUrl: false }} headings={headings}>
  <div class="notes-index not-content">
    <header class="index-intro">
      <p class="notes-eyebrow"><span class="edition-mark" aria-hidden="true">∴</span> COMPLETE INDEX</p>
      <p class="index-lead">{total} {total === 1 ? 'note' : 'notes'} across {populated.length} {populated.length === 1 ? 'track' : 'tracks'} and {subjects.length} {subjects.length === 1 ? 'subject' : 'subjects'}, newest first.</p>
      {latest && <p class="notes-meta">Last note added {formatDate(latest)} · <a href="/">back to the overview</a></p>}
    </header>
    {subjects.length > 1 && <nav class="subject-index" aria-label="Jump to a subject">
      <span class="index-label">Jump to</span>
      {populated.map(track => <div class="index-track">
        <span class="index-track-label">{track.label}</span>
        {track.subjects.map(subject => <a href={`#subject-${subject.slug}`}>{subject.label}<sup>{subject.count}</sup></a>)}
      </div>)}
    </nav>}
    {populated.map(track => <section class="track-section" aria-labelledby={`track-${track.key}`}>
      <div class="section-heading track-heading">
        <h2 id={`track-${track.key}`}>{track.label}</h2>
        <span class="section-count">{track.count} {track.count === 1 ? 'note' : 'notes'} in {track.subjectCount} {track.subjectCount === 1 ? 'subject' : 'subjects'}</span>
        <a class="section-more" href={track.href}>Track page <span aria-hidden="true">↗</span></a>
        {track.blurb && <p class="track-heading-blurb">{track.blurb}</p>}
      </div>
      {track.subjects.map(subject => <section class="notes-section" aria-labelledby={`subject-${subject.slug}`}>
        <div class="section-heading">
          <h3 id={`subject-${subject.slug}`}>{subject.label}</h3>
          <span class="section-count">{subject.count} {subject.count === 1 ? 'note' : 'notes'}{subject.updated && <span class="section-updated"> · {formatDate(subject.updated)}</span>}</span>
          <a class="section-more" href={subject.href}>Subject page <span aria-hidden="true">↗</span></a>
        </div>
        <ol class="note-rows">{subject.notes.map(note => <NoteRow note={note} subject={subject} />)}</ol>
      </section>)}
    </section>)}
    {!total && <p class="notes-empty">The notebook is taking shape. New notes are on the way.</p>}
  </div>
</StarlightPage>
