---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import NoteCard from '../../components/NoteCard.astro';
import notes from '../../../.generated/notes.json';
import subjectManifests from '../../../.generated/subjects.json';
import { buildLibrary, formatDate, ALL_NOTES_PATH } from '../../lib/notebook.mjs';
// One page per subject, generated from the notes repository layout: a new notes
// directory becomes a new subject page without any edit here. Every subject page
// states the track it belongs to, so mathematics and physics stay distinguishable
// wherever a reader lands.
const library = buildLibrary(notes, subjectManifests);
// Astro hoists getStaticPaths out of the component, so it builds its own view of
// the same library instead of closing over the one below.
export function getStaticPaths() {
  return buildLibrary(notes, subjectManifests).subjects
    .map(subject => ({ params: { subject: subject.slug }, props: { subject } }));
}
const { subject } = Astro.props;
const track = library.tracks.find(item => item.key === subject.track.key);
const others = library.subjects.filter(other => other.key !== subject.key);
const sameTrack = others.filter(other => other.track.key === subject.track.key);
const otherTracks = library.tracks.filter(item => item.key !== subject.track.key && item.subjects.length > 0);
const description = subject.blurb || `Notes filed under ${subject.label} in this notebook.`;
---
<StarlightPage frontmatter={{ title: subject.label, description, editUrl: false }} headings={[]}>
  <div class="subject-page not-content">
    <header class="subject-intro">
      <p class="notes-eyebrow"><span class="edition-mark" aria-hidden="true">∴</span> {track ? `${track.label.toUpperCase()} · ` : ''}SUBJECT</p>
      <p class="subject-lead">{subject.blurb || `Everything filed under ${subject.label} in this notebook.`}</p>
      <p class="notes-meta">{subject.count} {subject.count === 1 ? 'note' : 'notes'}{subject.updated && <span> · last note {formatDate(subject.updated)}</span>}{track && <span> · part of <a href={track.href}>{track.label}</a></span>} · <a href={ALL_NOTES_PATH}>all notes</a> · <a href="/">overview</a></p>
    </header>
    <div class="notes-grid">{subject.notes.map(note => <NoteCard note={note} subject={subject} showSubject={false} />)}</div>
    {others.length > 0 && <nav class="track-neighbours" aria-label="Other subjects">
      {sameTrack.length > 0 && <div class="track-neighbours-group">
        <span class="index-label">More in {track?.label || 'this track'}</span>
        {sameTrack.map(other => <a href={other.href}>{other.label}<sup>{other.count}</sup></a>)}
      </div>}
      {otherTracks.map(other => <div class="track-neighbours-group">
        <span class="index-label">{other.label}</span>
        {other.subjects.map(item => <a href={item.href}>{item.label}<sup>{item.count}</sup></a>)}
      </div>)}
    </nav>}
  </div>
</StarlightPage>
