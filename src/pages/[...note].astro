---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import notes from '../../.generated/notes.json';
import subjectManifests from '../../.generated/subjects.json';
import { buildLibrary, subjectOf, trackOf, formatDate, ALL_NOTES_PATH } from '../lib/notebook.mjs';
export function getStaticPaths() {
  return notes.map(note => ({ params: { note: note.file.replace(/\.html$/, '') }, props: { note } }));
}
const { note } = Astro.props;
const stem = '/' + note.file.replace(/\.html$/, '');
const library = buildLibrary(notes, subjectManifests);
const subject = subjectOf(library, note.file);
// The context line walks the whole hierarchy: track, then subject, then index.
const track = trackOf(library, note.file);
---
<StarlightPage headings={note.headings} frontmatter={{ title: note.title, description: note.description, editUrl: `https://github.com/zzjrabbit/notes/edit/main/${note.file.replace(/\.html$/, '.typ')}` }}>
  <style is:inline set:html={note.mathCSS} />
  <nav class="note-context" aria-label="Notebook location" data-pagefind-ignore>
    {track && <><a href={track.href}>{track.label}</a><span aria-hidden="true">/</span></>}
    {subject && <a href={subject.href}>{subject.label}</a>}
    <span aria-hidden="true">/</span>
    <a href={ALL_NOTES_PATH}>All notes</a>
    {note.date && <time class="note-date" datetime={note.date}>{formatDate(note.date)}</time>}
  </nav>
  <div class="note-tools" data-pagefind-ignore>
    <a href={stem + '.pdf'}>Read / download PDF ↗</a>
    {note.leanSource && <a class="lean-source-link" href={note.leanSource}>View Lean source <span aria-hidden="true">↗</span></a>}
    <a href={stem + '.typ'} download aria-describedby="source-download-note">Download single-file Typst source ↓</a>
  </div>
  <p id="source-download-note" class="notes-meta" data-pagefind-ignore>The source download includes only this article, without shared templates or dependencies. To compile it, clone the <a href="https://github.com/zzjrabbit/notes">notes repository</a> and follow its setup instructions.</p>
  <div class="typst-article calepin-website-main" lang="en" set:html={note.html} />
  <details class="note-source" data-pagefind-ignore>
    <summary>View Typst source</summary>
    <pre><code>{note.source}</code></pre>
  </details>
</StarlightPage>
<script>
  import '../../site/themes/site/js/math.js';
</script>
