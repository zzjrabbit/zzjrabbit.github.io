    "check": "node --test tests/*.test.mjs",
    "preview": "astro preview"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.0",
    "@astrojs/sitemap": "3.7.4",
    "@astrojs/starlight": "0.42.0",
    "astro": "7.3.2",
    "cheerio": "1.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0"
  }
}
